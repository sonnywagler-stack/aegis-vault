{%- liquid
  assign products = section.settings.products
  if products == blank or products.size == 0
    assign products = collections.all.products
  endif
-%}
<section class="section{% if section.settings.alt %} section--alt{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container">
    <header class="section__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </header>
    {%- if products.size > 0 -%}
      <div class="products">
        {%- for product in products limit: section.settings.limit -%}
          {%- assign featured = false -%}
          {%- if forloop.first and section.settings.feature_first -%}{%- assign featured = true -%}{%- endif -%}
          {% render 'product-card', product: product, featured: featured %}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_all -%}
        <p class="section__more"><a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">Voir tous les produits</a></p>
      {%- endif -%}
    {%- else -%}
      <p class="empty">Aucun produit publié pour le moment.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produits en vedette",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "boutique" },
    { "type": "checkbox", "id": "alt", "label": "Fond alterné", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Boutique" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le Vault et ses compagnons" },
    { "type": "product_list", "id": "products", "label": "Produits", "limit": 12, "info": "Vide : tous les produits publiés." },
    { "type": "range", "id": "limit", "label": "Nombre maximum", "min": 1, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "feature_first", "label": "Mettre en avant le premier produit", "default": true },
    { "type": "checkbox", "id": "show_all", "label": "Bouton « Voir tous les produits »", "default": false }
  ],
  "presets": [ { "name": "Produits en vedette" } ]
}
{% endschema %}
