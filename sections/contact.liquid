<section class="section{% if section.settings.alt %} section--alt{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container contact">
    <div class="contact__intro reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="contact__text">{{ section.settings.text }}</div>{%- endif -%}
      <ul class="contact__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.label }}</strong> {{ block.settings.value }}</li>
        {%- endfor -%}
      </ul>
    </div>

    {%- form 'contact', id: 'ContactForm', class: 'form reveal' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__status ok" role="status">Merci ! Votre message a bien été envoyé, nous vous répondons sous 24 h.</p>
      {%- elsif form.errors -%}
        <p class="form__status err" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="form__row">
        <label>Nom<input type="text" name="contact[Nom]" required autocomplete="name" value="{{ form.name }}"></label>
        <label>Email<input type="email" name="contact[email]" required autocomplete="email" value="{{ form.email }}"></label>
      </div>
      <label>Sujet
        <select name="contact[Sujet]">
          <option>Question sur le Vault 3×3</option>
          <option>Commande professionnelle</option>
          <option>Projet sur mesure</option>
          <option>Suivi de commande</option>
        </select>
      </label>
      <label>Message<textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea></label>
      <button type="submit" class="btn btn--gold">Envoyer le message</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "contact" },
    { "type": "checkbox", "id": "alt", "label": "Fond alterné", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un projet sur mesure ?" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Commande pour boutique, format spécial ou simple question : nous répondons sous 24 h.</p>" }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Coordonnée",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé", "default": "Email" },
        { "type": "text", "id": "value", "label": "Valeur", "default": "contact@aegisvault.fr" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact",
      "blocks": [
        { "type": "info", "settings": { "label": "Email", "value": "contact@aegisvault.fr" } },
        { "type": "info", "settings": { "label": "Instagram", "value": "@aegisvault" } },
        { "type": "info", "settings": { "label": "Horaires", "value": "Lun – Ven, 9h – 18h" } }
      ]
    }
  ]
}
{% endschema %}
