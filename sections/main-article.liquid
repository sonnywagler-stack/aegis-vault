<article class="section page-top">
  <div class="container container--narrow">
    <header class="section__head">
      <p class="eyebrow"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d/%m/%Y' }}</time></p>
      <h1 class="page-title">{{ article.title | escape }}</h1>
    </header>
    {%- if article.image -%}
      <div class="article__image">{{ article.image | image_url: width: 1400 | image_tag: sizes: '(min-width: 820px) 820px, 100vw', widths: '600, 900, 1400', alt: article.title }}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p class="section__more"><a class="btn btn--ghost" href="{{ blog.url }}">← Retour au blog</a></p>
  </div>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
