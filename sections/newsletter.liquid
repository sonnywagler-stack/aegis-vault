<section class="newsletter">
  <div class="container newsletter__inner reveal">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form__status ok" role="status">Merci ! Vous êtes inscrit.</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="Votre adresse email" required aria-label="Adresse email" autocomplete="email">
        <button type="submit" class="btn btn--gold">S'inscrire</button>
      {%- endif -%}
      {%- if form.errors -%}<p class="form__status err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Rejoignez le Vault" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Nouveaux formats, restocks et accès anticipé aux séries limitées." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
