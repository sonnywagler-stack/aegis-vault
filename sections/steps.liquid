<section class="section{% if section.settings.alt %} section--alt{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container">
    <header class="section__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </header>
    <ol class="steps" style="--cols: {{ section.blocks.size | at_most: 5 | at_least: 1 }}">
      {%- for block in section.blocks -%}
        <li class="step reveal" {{ block.shopify_attributes }}>
          <span class="step__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Étapes",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "montage" },
    { "type": "checkbox", "id": "alt", "label": "Fond alterné", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Fabrication" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "29 pièces, assemblées à la main" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Chaque Vault est assemblé selon une séquence précise, vérifiée à chaque étape." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Étape" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Décrivez l'étape." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Étapes",
      "blocks": [
        { "type": "step", "settings": { "title": "Fond double", "text": "Deux plaques de 8 mm collées, roulettes boulonnées en M6 à 60 mm des bords." } },
        { "type": "step", "settings": { "title": "Parois", "text": "Quatre parois soudées à la colle PMMA, diagonales contrôlées à 1 mm près." } },
        { "type": "step", "settings": { "title": "Cloisons", "text": "Posées au gabarit 195 × 171 pour 9 compartiments identiques." } },
        { "type": "step", "settings": { "title": "Cadres aimantés", "text": "Aimants marqués, orientés et collés à fleur, sur les parois puis sous le couvercle." } },
        { "type": "step", "settings": { "title": "Pastilles", "text": "Six pastilles de liaison à mi-hauteur, testées une par une au témoin." } }
      ]
    }
  ]
}
{% endschema %}
