<section class="section{% if section.settings.alt %} section--alt{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container">
    <header class="section__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </header>
    <div class="features">
      {%- for block in section.blocks -%}
        <article class="feature reveal" {{ block.shopify_attributes }}>
          <div class="feature__icon">{% render 'icon', icon: block.settings.icon %}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Points forts",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (pour les liens #)", "default": "vault" },
    { "type": "checkbox", "id": "alt", "label": "Fond alterné", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Le Vault 3×3" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pensé au millimètre pour l'ETB" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Chaque compartiment laisse 1,5 mm de jeu autour d'une ETB de 192 × 168 × 92 mm : elle entre sans forcer et ne bouge plus." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Point fort",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "shield",
          "options": [
            { "value": "grid", "label": "Grille" },
            { "value": "magnet", "label": "Aimant" },
            { "value": "wheels", "label": "Roulettes" },
            { "value": "link", "label": "Liaison" },
            { "value": "shield", "label": "Bouclier" },
            { "value": "clock", "label": "Horloge" },
            { "value": "truck", "label": "Livraison" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Point fort" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Décrivez un avantage du produit." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Points forts",
      "blocks": [
        { "type": "feature", "settings": { "icon": "grid", "title": "9 compartiments pleins", "text": "Des cloisons de 8 mm sans encoche séparent chaque coffret. Rien ne frotte, rien ne glisse." } },
        { "type": "feature", "settings": { "icon": "magnet", "title": "Couvercle aimanté", "text": "Deux cadres identiques portent 6 paires d'aimants N52. Le couvercle se plaque seul, dans les deux sens." } },
        { "type": "feature", "settings": { "icon": "wheels", "title": "Sur roulettes", "text": "Fond double de 16 mm, 4 roulettes vissées en M6 et freins pour bloquer le module en place." } },
        { "type": "feature", "settings": { "icon": "link", "title": "Assemblable en mur", "text": "Six pastilles aimantées sur les côtés accrochent un module à son voisin, dans les 4 directions." } },
        { "type": "feature", "settings": { "icon": "shield", "title": "Acrylique coulé", "text": "Du PMMA coulé transparent de 8 mm, plus rigide et plus clair qu'un plastique injecté." } },
        { "type": "feature", "settings": { "icon": "clock", "title": "Polarité contrôlée", "text": "Chaque aimant est orienté au montage : deux modules s'attirent toujours, ils ne peuvent pas se repousser." } }
      ]
    }
  ]
}
{% endschema %}
