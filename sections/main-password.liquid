<section class="password">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="password__inner">
    {% render 'logo' %}
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="password__msg">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelancement">
      {%- if form.posted_successfully? -%}
        <p class="form__status ok">Merci ! Nous vous prévenons dès l'ouverture.</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="Votre adresse email" required aria-label="Adresse email">
        <button type="submit" class="btn btn--gold">Me prévenir</button>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>Accès avec mot de passe</summary>
      {%- form 'storefront_password', class: 'newsletter__form' -%}
        {%- if form.errors -%}<p class="form__status err">Mot de passe incorrect.</p>{%- endif -%}
        <input type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe" autocomplete="current-password">
        <button type="submit" class="btn btn--ghost">Entrer</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Page d'attente",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Ouverture prochaine" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le Vault ouvre bientôt" }
  ]
}
{% endschema %}
